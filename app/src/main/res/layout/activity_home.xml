<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7FB"
    tools:context=".HomeActivity">

    <TextView
        android:id="@+id/titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:text="MyTask"
        android:textColor="#272140"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titre"
        android:layout_marginStart="24dp"
        android:textColor="#6B7280"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/layoutListe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/textEmail"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editRecherche"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_palette"
            android:drawableEnd="@android:drawable/ic_menu_search"
            android:elevation="2dp"
            android:hint="Rechercher un titre, un tag"
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#272140"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="Notes"
            android:textColor="#272140"
            android:textSize="16sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/listeNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutVide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:text="Bonne Journée !!"
            android:textColor="#272140"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="48dp"
            android:text="Félicitation, vous n'avez aucune tâche en attente."
            android:textAlignment="center"
            android:textColor="#272140"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/boutonAjouter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#FF5B74"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="28sp" />

</RelativeLayout>