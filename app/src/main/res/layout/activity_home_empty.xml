<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:backgroundTint="#F2F7FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home_empty">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MyTask"
        android:id="@+id/text1"
        android:textSize="45dp"
        android:textStyle="bold"
        android:layout_marginTop="7dp"
        android:layout_marginLeft="20dp"/>

    <TextView
        android:id="@+id/recup_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:layout_marginLeft="30dp"
        android:layout_below="@id/text1"/>

    <TextView
        android:id="@+id/good_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bonne journée !! "
        android:textSize="45dp"
        android:textColor="#272140"
        android:layout_marginTop="330dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/congrat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/good_day"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:textSize="18dp"
        android:text="Félicitation , vous n'avez aucune tâche en "/>




    <!-- ZONE 2 : La liste des notes (cachée au début) -->
    <ScrollView
        android:id="@+id/scroll_notes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/recup_email"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="80dp"
        android:visibility="gone"> <!-- On la cache au début -->

        <LinearLayout
            android:id="@+id/notes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />
    </ScrollView>
    <TextView
        android:id="@+id/attente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/good_day"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:textSize="18dp"
        android:text="attente"/>


    <Button
        android:id="@+id/bntAdd"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#FF5B74"
        android:padding="0dp"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="30sp" />


</RelativeLayout>



